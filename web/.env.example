# Copy to .env.local and fill in with the real project's web config when it exists.
# With the demo project, the app talks only to the local emulators (npm run emulators at the repo root).
VITE_FIREBASE_PROJECT_ID=demo-perros-tesis
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-perros-tesis.firebaseapp.com
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=true
# Browser notifications: project number and the Web Push certificate (Firebase console → Project settings
# → Cloud Messaging → Web configuration → Generate key pair). Without them the app hides the notifications switch.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
