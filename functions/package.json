{
  "name": "functions",
  "private": true,
  "description": "Cloud Functions (2nd gen): roles, inference pipeline (phases 1-2) and alerts.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "copy-shared": "node scripts/copy-shared.cjs",
    "build": "npm run copy-shared && tsc",
    "build:watch": "npm run copy-shared && tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
